{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "src/**/*.server.ts",
    "src/app/extensions/**/extension.{ts,tsx}",
    "src/app/settings/**/*.{ts,tsx}",
    "src/app/events/**/*.{ts,tsx}",
    "src/app/webhooks/**/*.{ts,tsx}",
    "src/app/blocks/**/*.{ts,tsx}"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "ignore": [
    "src/__mocks__/**"
  ],
  "rules": {
    "files": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "enumMembers": "error",
    "namespaceMembers": "error",
    "duplicates": "off",
    "dependencies": "off",
    "devDependencies": "off",
    "optionalPeerDependencies": "off",
    "binaries": "off",
    "catalog": "off",
    "unlisted": "off",
    "unresolved": "off"
  }
}
